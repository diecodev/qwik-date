{
  "name": "qwik-date",
  "version": "1.0.0",
  "description": "Qwik calendar, simple integration.",
  "keywords": [
    "qwik",
    "qwik library",
    "typescript",
    "qwik date",
    "calendar",
    "qwik calendar",
    "qwik date picker",
    "qwik calendar picker",
    "date picker",
    "calendar picker"
  ],
  "author": {
    "name": "diecodev",
    "url": "https://github.com/diecodev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diecodev/qwik-date.git"
  },
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.qwik.mjs"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.website": "pnpm build.types && pnpm build.lib && pnpm -C website build.client && pnpm -C website build.server",
    "build.lib": "vite build --mode lib",
    "build.types": "tsc --emitDeclarationOnly -p ./tsconfig.lib.json",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "biome check --write --unsafe",
    "prepublishOnly": "pnpm build",
    "release": "bumpp --commit --tag --push",
    "start": "vite --open --mode ssr",
    "test": "pnpm test.unit && pnpm test.e2e",
    "test.unit": "vitest run",
    "test.e2e": "playwright test",
    "qwik": "qwik"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-rc.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@playwright/test": "^1.64.1",
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "@types/node": "^22.12.0",
    "bumpp": "9.4.1",
    "np": "^10.0.7",
    "tsx": "^4.16.3",
    "typescript": "^5.9.3",
    "undici": "^6.19.5",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
